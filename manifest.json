{
  "manifest_version": 3,
  "name": "RoleReady",
  "version": "0.2.2",
  "description": "Evidence-first job analysis beside supported job postings.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["https://www.linkedin.com/jobs/*", "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://simplify.jobs/*", "https://careers.google.com/*", "https://www.google.com/about/careers/*", "https://*.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open RoleReady",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://simplify.jobs/*", "https://careers.google.com/*", "https://www.google.com/about/careers/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
