{
  "manifest_version": 3,
  "name": "RoleReady",
  "version": "0.2.0",
  "description": "Evidence-first job analysis beside supported job postings.",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://*.linkedin.com/*", "https://*.greenhouse.io/*", "https://*.lever.co/*", "https://simplify.jobs/*", "https://*.google.com/*", "https://*.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open RoleReady" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*", "https://*.greenhouse.io/*", "https://*.lever.co/*", "https://simplify.jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
