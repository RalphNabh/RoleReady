# Never commit a real key. Configure these in Vercel Project Settings → Environment Variables.
OPENROUTER_API_KEY=
EXA_API_KEY=
# Supabase Dashboard → Project Settings → API. The anon key is safe to expose to the app;
# Row Level Security in supabase/schema.sql protects each candidate's data.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. Defaults to OpenRouter's documented latest OpenAI alias.
OPENROUTER_MODEL=~openai/gpt-latest
# Optional OpenRouter audio defaults. Browser speech remains a fallback if a model is unavailable.
OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
# Set after deployment, for OpenRouter attribution.
APP_URL=
# Copy Chrome's extension ID into this exact form to limit browser access.
ALLOWED_EXTENSION_ORIGIN=chrome-extension://your-extension-id
